library(ggplot2)
library(plotly)
library(dplyr)
# 读取数据（确保 `ncvs_data.csv` 在当前目录）
ncvs_data <- read.csv("data/NCVS_2020.csv")
# 处理 Quarter_Label
ncvs_data <- ncvs_data %>%
mutate(Quarter_Label = recode(QUARTER,
`1` = "Q1 (Jan - Mar)",
`2` = "Q2 (Apr - Jun)",
`3` = "Q3 (Jul - Sep)",
`4` = "Q4 (Oct - Dec)"))
ncvs_data <- read.csv("data/NCVS_2020.csv")
ncvs_data <- ncvs_data %>%
separate(YEARQ, into = c("YEAR", "QUARTER"), sep = "\\.", convert = TRUE)
ncvs_data <- ncvs_data %>%
mutate(Region_Label = recode(REGION, `1` = "Northeast", `2` = "Midwest", `3` = "South", `4` = "West"))|>
mutate(Quarter_Label = recode(QUARTER,
`1` = "Q1 (Jan - Mar)",
`2` = "Q2 (Apr - Jun)",
`3` = "Q3 (Jul - Sep)",
`4` = "Q4 (Oct - Dec)"))
#-------------------------------------------------------------------------------------------------
ncvs_p1 <- ncvs_data %>%
select(c(AGE, NUM_INCIDENTS))%>%
filter(
!AGE == 98 | !AGE == 99,
!NUM_INCIDENTS == 98 | !NUM_INCIDENTS == 99
) %>%
group_by(AGE) %>%
mutate(
total_incident = sum(NUM_INCIDENTS)
) %>%
distinct(AGE, total_incident)
#-------------------------------------------------------------------------------------------------
ncvs_p2 <- ncvs_data %>%
select(INCOME, NUM_INCIDENTS) %>%
filter(!INCOME %in% c(98, 99), !NUM_INCIDENTS %in% c(98, 99)) %>%
group_by(INCOME) %>%
summarise(total_incident = sum(NUM_INCIDENTS, na.rm = TRUE))
#-------------------------------------------------------------------------------------------------
us_states <- map_data("state")
region_mapping <- data.frame(
region = tolower(c(
"Maine", "New Hampshire", "Vermont", "Massachusetts", "Rhode Island", "Connecticut", "New York", "New Jersey", "Pennsylvania"
)),
Region_Label = "Northeast"
) %>%
bind_rows(data.frame(
region = tolower(c(
"Ohio", "Indiana", "Illinois", "Michigan", "Wisconsin", "Minnesota", "Iowa", "Missouri", "North Dakota", "South Dakota", "Nebraska", "Kansas"
)),
Region_Label = "Midwest"
)) %>%
bind_rows(data.frame(
region = tolower(c(
"Delaware", "Maryland", "District of Columbia", "Virginia", "West Virginia", "Kentucky", "North Carolina", "South Carolina",
"Georgia", "Florida", "Alabama", "Mississippi", "Tennessee", "Arkansas", "Louisiana", "Oklahoma", "Texas"
)),
Region_Label = "South"
)) %>%
bind_rows(data.frame(
region = tolower(c(
"Montana", "Idaho", "Wyoming", "Colorado", "New Mexico", "Arizona", "Utah", "Nevada", "Washington", "Oregon", "California", "Alaska", "Hawaii"
)),
Region_Label = "West"
))
region_crime <- ncvs_data %>%
group_by(Region_Label) %>%
summarise(Total_Incidents = sum(NUM_INCIDENTS, na.rm = TRUE))
us_map_data <- us_states %>%
left_join(region_mapping, by = "region") %>%
left_join(region_crime, by = "Region_Label")
us_map_data <- us_map_data %>%
mutate(group = as.factor(group),
Total_Incidents = as.numeric(Total_Incidents)) %>%
drop_na(Total_Incidents)
# 加载必要的包
library(ggplot2)
library(plotly)
library(dplyr)
# 读取数据（确保 `ncvs_data.csv` 在当前目录）
# 处理 Quarter_Label
ncvs_data <- ncvs_data %>%
mutate(Quarter_Label = recode(QUARTER,
`1` = "Q1 (Jan - Mar)",
`2` = "Q2 (Apr - Jun)",
`3` = "Q3 (Jul - Sep)",
`4` = "Q4 (Oct - Dec)"))
# 计算各季度总犯罪数
filtered_data <- ncvs_data %>%
group_by(Quarter_Label) %>%
summarise(Total_Incidents = sum(NUM_INCIDENTS, na.rm = TRUE))
# 颜色定义
colors <- c("#1E90FF", "#32CD32", "#DC143C", "#FFA500")
# 生成 ggplot2 图
gg <- ggplot(filtered_data, aes(x = Quarter_Label, y = Total_Incidents, fill = Quarter_Label)) +
geom_bar(stat = "identity", show.legend = FALSE, alpha = 0.7) +
scale_fill_manual(values = colors) +
labs(title = "Seasonal Crime Trends",
x = "Quarter (Month Range)",
y = "Total Incidents") +
theme_minimal()
# 保存静态 ggplot 图像
ggsave("quarter_plot.png", plot = gg, width = 8, height = 6, dpi = 300)
ggsave("quarter_plot.pdf", plot = gg, width = 8, height = 6)
# 生成 plotly 交互式图
p <- ggplotly(gg)
# 保存 plotly 交互式 HTML
htmlwidgets::saveWidget(as_widget(p), "quarter_plot.html")
# 保存 plotly PNG（需要 `orca` 工具）
# 安装 orca (仅需一次)： https://github.com/plotly/orca
# plotly_IMAGE(p, format = "png", out_file = "quarter_plotly.png")
# 打印消息
print("✅ Plots saved successfully: quarter_plot.png, quarter_plot.pdf, quarter_plot.html")
