geom_point(size = 2, alpha = 0.7) +
geom_smooth(aes(group = 1), method = "gam", formula = y ~ s(x, bs = "cs"), se = FALSE, color = "#FF7F00") +
scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE, na.rm = TRUE), by = 5)) +
