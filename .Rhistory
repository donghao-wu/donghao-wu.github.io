knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(plotly)
library(colorspace)
# The data will be saved as ncvs
ncvs <- read_csv("data/NCVS_2020.csv")
#Data for the first plot will be saved as ncvs_p1
ncvs_p1 <- ncvs|>
select(c(AGE, NUM_INCIDENTS))|>
filter(
!AGE == 98 | !AGE == 99,
!NUM_INCIDENTS == 98 | !NUM_INCIDENTS == 99
)|>
group_by(AGE)|>
mutate(
total_incident = sum(NUM_INCIDENTS)
)|>
distinct(AGE, total_incident)
#the default plot is saved as p1_d
p1_d <- ncvs_p1|>
ggplot(aes(x = AGE, y = total_incident)) +
geom_point() +
geom_smooth()
p1_d
#the alternative plot will be saved as p1_a
p1_a <- ncvs_p1|>
ggplot(aes(x = AGE, y = total_incident, fill = AGE)) +
geom_col(alpha = 0.8) +
scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE), by = 5)) +
labs(
title = "Relationship between Age and Total Incidents",
subtitle = "Source: https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Age",
y = "Total Incidents"
) +
theme_minimal()+
theme(
plot.title = element_text(face = "bold", size = 13),
plot.subtitle = element_text(face = "italic", size = 10)
)
p1_a
#the refined graph will be saved as p1_r
p1_r <- ncvs_p1|>
ggplot(aes(x = AGE, y = total_incident, color = factor(AGE >= 27 & AGE <= 61,
levels = c(TRUE, FALSE),
labels = c("Higher-Risk Group",
"Lower-Risk Group")))) +
geom_point(size = 2, alpha = 0.5) +
geom_smooth(method = "loess", se = FALSE, color = "#E69F00") +
scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE), by = 5)) +
scale_y_continuous(breaks = seq(0, 400, by = 50)) +
scale_color_manual(values = c("Lower-Risk Group" = "#009E73", "Higher-Risk Group" = "red"),
labels = c("Lower-Risk Group", "Higher-Risk Group"),
name = "Age Group") +
labs(
title = "Relationship Between Total Number of Incidents and Age",
subtitle = "Source: https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Age",
y = "Total Number of Incidents"
) +
theme(
plot.title = element_text(size = 13, face = "bold"),
plot.subtitle = element_text(size = 10, face = "italic"),
legend.position = "right"
) +
theme_minimal()
ggplotly(p1_r)
#the refined graph will be saved as p1_r
p1_r <- ncvs_p1|>
ggplot(aes(x = AGE, y = total_incident, color = factor(AGE >= 27 & AGE <= 61,
levels = c(TRUE, FALSE),
labels = c("Higher-Risk Group",
"Lower-Risk Group")))) +
geom_point(size = 2, alpha = 0.5) +
geom_smooth(method = "loess", se = FALSE, color = "#E69F00") +
scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE), by = 5)) +
scale_y_continuous(breaks = seq(0, 400, by = 50)) +
scale_color_manual(values = c("Lower-Risk Group" = "#009E73", "Higher-Risk Group" = "red"),
labels = c("Lower-Risk Group", "Higher-Risk Group"),
name = "Age Group") +
labs(
title = "Relationship Between Total Number of Incidents and Age",
subtitle = "Source: https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Age",
y = "Total Number of Incidents"
) +
theme(
plot.title = element_text(size = 13, face = "bold"),
plot.subtitle = element_text(size = 10, face = "italic"),
legend.position = "right"
) +
theme_minimal()
p <- ggplotly(p1_r)
htmlwidgets::saveWidget(p, "plotly1.html", selfcontained = TRUE)
#Data for the second plot will be saved as ncvs_p2
ncvs_p2 <- ncvs|>
select(c(INCOME, NUM_INCIDENTS))|>
filter(
!INCOME == 98 | !INCOME == 99,
!NUM_INCIDENTS == 98 | !NUM_INCIDENTS == 99
)|>
group_by(INCOME)|>
mutate(
total_incident = sum(NUM_INCIDENTS)
)|>
distinct(INCOME, total_incident)
#default histogram will be saved as p2_d
p2_d <- ncvs_p2|>
ggplot(aes(x = factor(INCOME), y = total_incident)) +
geom_bar(stat = "identity")
p2_d
# The refined plot 2 will be saved as p2_r
p2_r <- ncvs_p2 |>
ggplot(aes(x = factor(INCOME), y = total_incident, fill = factor(INCOME))) +
geom_bar(stat = "identity", alpha = 0.7) +
scale_fill_manual(values = qualitative_hcl(18, palette = "Set 2")) +
labs(
title = "Total Crime Incidents by Income Level",
subtitle = "Source:https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Income Level",
y = "Total Number of Incidents",
fill = "Income level"
) +
theme_minimal() +
theme(
legend.text = element_text(size = 8),
legend.title = element_text(size = 8)
) +
guides(fill = guide_legend(nrow = 3))
ggplotly(p2_r)
# The refined plot 2 will be saved as p2_r
p2_r <- ncvs_p2 |>
ggplot(aes(x = factor(INCOME), y = total_incident, fill = factor(INCOME))) +
geom_bar(stat = "identity", alpha = 0.7) +
scale_fill_manual(values = qualitative_hcl(18, palette = "Set 2")) +
labs(
title = "Total Crime Incidents by Income Level",
subtitle = "Source:https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Income Level",
y = "Total Number of Incidents",
fill = "Income level"
) +
theme_minimal() +
theme(
legend.text = element_text(size = 8),
legend.title = element_text(size = 8)
) +
guides(fill = guide_legend(nrow = 3))
ggplotly(p2_r)
p2 <- ggplotly(p2_r)
htmlwidgets::saveWidget(p2, "plotly2.html", selfcontained = TRUE)
# The refined plot 2 will be saved as p2_r
p2_r <- ncvs_p2 |>
ggplot(aes(x = factor(INCOME), y = total_incident, fill = factor(INCOME))) +
geom_bar(stat = "identity", alpha = 0.7) +
scale_fill_manual(values = qualitative_hcl(18, palette = "Set 2")) +
labs(
title = "Total Crime Incidents by Income Level",
subtitle = "Source:https://www.icpsr.umich.edu/web/NACJD/studies/38090/summary",
x = "Income Level",
y = "Total Number of Incidents",
fill = "Income level"
) +
theme_minimal() +
theme(
legend.text = element_text(size = 8),
legend.title = element_text(size = 8)
) +
guides(fill = guide_legend(nrow = 3))
ggsave("income.png", plot = p2_r)
ggplotly(p2_r)
p2 <- ggplotly(p2_r)
htmlwidgets::saveWidget(p2, "plotly2.html", selfcontained = TRUE)
