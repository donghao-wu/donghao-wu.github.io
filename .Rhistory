left_join(region_crime, by = "Region_Label")
us_map_data <- us_map_data %>%
mutate(group = as.factor(group),
Total_Incidents = as.numeric(Total_Incidents)) %>%
drop_na(Total_Incidents)
#Data for the second plot will be saved as ncvs_p2
gg <- ggplot(ncvs_data, aes_string(x = AGE)) +
geom_histogram(fill = "#3498db", color = "white", bins = 30, alpha = 0.8) +
labs(title = paste("Distribution of", AGE),
x = AGE, y = "Count") +
theme_minimal()
library(ggplot2)
library(plotly)
library(htmlwidgets)
# 绘制直方图
gg <- ggplot(ncvs_data, aes_string(x = "AGE")) +
geom_histogram(fill = "#3498db", color = "white", bins = 30, alpha = 0.8) +
labs(title = "Distribution of AGE", x = "AGE", y = "Count") +
theme_minimal()
# 生成 plotly 交互式图
p <- ggplotly(gg)
# 📌 **保存静态图像**
ggsave("age_hist.png", plot = gg, width = 8, height = 6, dpi = 300, bg = "white")
# 📌 **保存 plotly 交互式 HTML**
saveWidget(as_widget(p), "age_hist.html")
print("✅ Plots saved successfully: age_hist.png, age_hist.html")
