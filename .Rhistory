scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE, na.rm = TRUE), by = 5)) +
scale_y_continuous(limits = c(0, max(ncvs_p1$total_incident, na.rm = TRUE) * 1.1)) +
scale_color_manual(values = risk_colors, name = "Risk Group") +
labs(
title = "Crime Incidents by Age Group",
subtitle = "High-Risk Group is defined as having total incidents above the median",
x = "Age",
y = "Total Number of Incidents"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11, face = "italic"),
legend.position = "right"
)
# 📌 **保存静态图像**
ggsave("scatterplot_age.png", plot = gg, width = 8, height = 6, dpi = 300)
ggsave("scatterplot_age.pdf", plot = gg, width = 8, height = 6)
# 📌 **生成 Plotly 交互式图**
p <- ggplotly(gg)
# 📌 **保存交互式 HTML**
saveWidget(as_widget(p), "scatterplot_age.html")
# 打印成功消息
print("✅ Plots saved successfully: scatterplot_age.png, scatterplot_age.pdf, scatterplot_age.html")
# 加载必要的包
library(ggplot2)
library(plotly)
library(dplyr)
library(htmlwidgets)
library(mgcv)  # 确保 `gam` 方法可以使用
# 计算 `total_incident`（按 AGE 分组）
ncvs_p1 <- ncvs_data %>%
group_by(AGE) %>%
summarise(total_incident = sum(NUM_INCIDENTS, na.rm = TRUE)) %>%
drop_na(total_incident)
# 计算中位数，划分 High-Risk / Low-Risk
incident_median <- median(ncvs_p1$total_incident, na.rm = TRUE)
ncvs_p1 <- ncvs_p1 %>%
mutate(Risk_Group = ifelse(total_incident > incident_median, "High-Risk Group", "Low-Risk Group"))
# 定义颜色
risk_colors <- c("Low-Risk Group" = "#e9ff32",  # 深蓝色
"High-Risk Group" = "#E74C3C") # 深橙色
# 📌 **绘制散点图**
gg <- ggplot(ncvs_p1, aes(x = AGE, y = total_incident, color = Risk_Group, text = paste("Age:", AGE, "<br>Total Incidents:", total_incident))) +
geom_point(size = 2, alpha = 0.7) +
geom_smooth(aes(group = 1), method = "gam", formula = y ~ s(x, bs = "cs"), se = FALSE, color = "#FF7F00") +
scale_x_continuous(breaks = seq(10, max(ncvs_p1$AGE, na.rm = TRUE), by = 5)) +
scale_y_continuous(limits = c(0, max(ncvs_p1$total_incident, na.rm = TRUE) * 1.1)) +
scale_color_manual(values = risk_colors, name = "Risk Group") +
labs(
title = "Crime Incidents by Age Group",
subtitle = "High-Risk Group is defined as having total incidents above the median",
x = "Age",
y = "Total Number of Incidents"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11, face = "italic"),
legend.position = "right"
)
# 📌 **保存静态图像**
ggsave("scatterplot_age.png", plot = gg, width = 8, height = 6, dpi = 300)
ggsave("scatterplot_age.pdf", plot = gg, width = 8, height = 6)
# 📌 **生成 Plotly 交互式图**
p <- ggplotly(gg)
# 📌 **保存交互式 HTML**
saveWidget(as_widget(p), "scatterplot_age.html")
# 打印成功消息
print("✅ Plots saved successfully: scatterplot_age.png, scatterplot_age.pdf, scatterplot_age.html")
